# =====================================================================
#  AI Evaluation System — environment template
#  Copy to ".env" and fill in your real values:
#       Copy-Item .env.example .env
#
#  Paid tiers (all models): ollama, qwen, glm
#  Free/trial tiers (free models only): gemini, groq, openrouter,
#    cerebras, hf, poe, cohere, vercel, thinkingmachines
# =====================================================================

# --- PAID PROVIDERS ---
OLLAMA_API_KEY=ollama-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_BASE_URL=https://api.ollama.com/v1

QWEN_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# --- FREE / TRIAL PROVIDERS ---
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1

