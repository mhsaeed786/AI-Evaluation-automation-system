# =====================================================================
#  Ollama Cloud Evaluation System — environment template
#  Copy this file to ".env" and fill in your real values:
#       Copy-Item .env.example .env
# =====================================================================

# --- REQUIRED: your Ollama Cloud API key (Pro plan) -------------------
# Find it in your Ollama Cloud dashboard: https://ollama.com/cloud
# Never commit your real .env to git (it is already in .gitignore).
OLLAMA_API_KEY=ollama-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Ollama Cloud OpenAI-compatible base URL -------------------------
# DEFAULT: https://api.ollama.com/v1
# This is the endpoint published for Ollama Cloud's OpenAI-compatible API.
#
# RUNTIME CONFIRMATION REQUIRED: live web verification was unavailable when
# this project was generated (search quota exhausted). The smoke test
# (python -m src.smoke_test) calls GET /v1/models with your key and will
# tell you immediately whether this base URL is correct. If it fails with
# a connection/auth error, try the alternate candidates documented in the
# README ("Pinning the endpoint") and set the working one here.
OLLAMA_BASE_URL=https://api.ollama.com/v1

# --- Optional: org / workspace header if your plan requires it --------
# Leave blank unless your dashboard shows a workspace id.
OLLAMA_ORG_ID=

# --- Optional: deterministic sampling defaults -----------------------
# Used by the builtin engine when a benchmark does not override them.
OLLAMA_SEED=1234
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT=180

# --- Optional: HuggingFace token (GATED datasets, e.g. GPQA) ---------
# Most benchmarks here are public and do NOT need this. GPQA is gated:
#   1. accept the license at https://huggingface.co/datasets/Idavidrein/gpqa
#   2. create a token at https://huggingface.co/settings/tokens  (read access)
#   3. paste it below. The `datasets` library picks HF_TOKEN up automatically.
# Without it, GPQA is skipped gracefully; everything else still runs.
HF_TOKEN=
