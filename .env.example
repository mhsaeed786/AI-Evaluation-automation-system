POE_BASE_URL=https://api.poe.com/v1

COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

VERCEL_API_KEY=vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
