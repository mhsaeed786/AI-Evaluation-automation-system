# =====================================================================
#  Root .gitignore — covers the entire repo
# =====================================================================

# --- Secrets (NEVER commit) ---
.env
.env.local
.env.production
*.key
*.pem
*.p12

# --- Local scratch / ad-hoc scripts (frequently contain credentials) ---
/_tmp*
/_probe*
/_db*
/_test*
/_live*
/scratch/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / TypeScript (oneagent-super-app) ---
node_modules/
dist/
build/
*.cjs
*.js.map
.aistudio/

# --- Eval system runtime data (regenerable, often large or sensitive) ---
results/
data/
logs/
reports/

# --- SQLite databases ---
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Lockfiles (keep package-lock, ignore bun) ---
bun.lock
bun.lockb
